# Window functions: what cumulative aggregations and offsets compile to.

query II
SELECT "id", row_number() OVER (ORDER BY "id") AS "rn" FROM "orders" ORDER BY "id" LIMIT 4
----
1 1
2 2
3 3
4 4

query III
SELECT "id", "product_id", sum("quantity") OVER (PARTITION BY "product_id" ORDER BY "id") AS "running" FROM "orders" ORDER BY "id"
----
1 1 2
2 1 3
3 3 4
4 5 1
5 6 10
6 2 3
7 7 1
8 8 2
9 5 3
10 42 1

query IRR
SELECT "id", lag("total", 1) OVER (ORDER BY "id") AS "prev", lead("total", 1) OVER (ORDER BY "id") AS "next" FROM "orders" ORDER BY "id" LIMIT 4
----
1 NULL 29.46
2 58.92 141.56
3 29.46 65.71
4 141.56 134.20

query III
SELECT "id", rank() OVER (ORDER BY "quantity" DESC) AS "r", dense_rank() OVER (ORDER BY "quantity" DESC) AS "dr" FROM "orders" ORDER BY "id" LIMIT 5
----
1 4 4
2 7 5
3 2 2
4 7 5
5 1 1

query II
SELECT "id", count(*) OVER () AS "n" FROM "orders" ORDER BY "id" LIMIT 2
----
1 10
2 10

query III
SELECT "product_id", "qty", sum("qty") OVER (ORDER BY "product_id") AS "cum" FROM (SELECT "product_id", sum("quantity") AS "qty" FROM "orders" GROUP BY "product_id") s ORDER BY "product_id"
----
1 3 3
2 3 6
3 4 10
5 3 13
6 10 23
7 1 24
8 2 26
42 1 27

query IT
SELECT "id", first_value("title") OVER (PARTITION BY "category" ORDER BY "price") AS "cheapest" FROM "products" WHERE "category" IS NOT NULL ORDER BY "id"
----
1 Rustic Paper Wallet
2 Enormous Aluminum Shirt
3 Enormous Aluminum Shirt
4 Enormous Aluminum Shirt
5 Aerodynamic Bronze Hat
6 Aerodynamic Bronze Hat
7 Rustic Paper Wallet

query II
SELECT "id", ntile(2) OVER (ORDER BY "id") AS "half" FROM "orders" ORDER BY "id" LIMIT 6
----
1 1
2 1
3 1
4 1
5 1
6 2
