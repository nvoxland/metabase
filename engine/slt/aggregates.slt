# Aggregation, grouping, having, and aggregate-only queries.

query I
SELECT count(*) FROM "orders"
----
10

query II
SELECT count("note"), count(DISTINCT "product_id") FROM "orders"
----
6 8

query RRR
SELECT sum("total"), min("total"), max("total") FROM "orders"
----
1004.43 10.00 210.24

query TIR
SELECT "category", count(*) AS "n", sum("price") AS "revenue" FROM "products" GROUP BY "category" ORDER BY "category" NULLS LAST
----
Doohickey 3 130.57
Gizmo 2 91.38
Widget 2 79.13
NULL 1 80.50

query TR
SELECT "category", avg("price") AS "avg_price" FROM "products" WHERE "category" IS NOT NULL GROUP BY "category" HAVING count(*) > 1 ORDER BY "category"
----
Doohickey 43.523333
Gizmo 45.690000
Widget 39.565000

query II
SELECT "product_id", sum("quantity") AS "qty" FROM "orders" GROUP BY "product_id" ORDER BY "qty" DESC, "product_id" LIMIT 3
----
6 10
3 4
1 3

query TI
SELECT "active", count(*) FROM "products" GROUP BY "active" ORDER BY "active"
----
false 2
true 6

query I
SELECT count(*) FILTER (WHERE "note" IS NULL) AS "no_note" FROM "orders"
----
4

query T
SELECT max("created_at") FROM "orders"
----
2021-05-05T05:05:05Z

query TR
SELECT "category", stddev_samp("price") AS "sd" FROM "products" WHERE "category" IS NOT NULL GROUP BY "category" ORDER BY "category"
----
Doohickey 23.567210979098338
Gizmo 22.952686117315338
Widget 36.974613588244566
