# Joins and subqueries.

query IT
SELECT o."id", p."title" FROM "orders" o JOIN "products" p ON o."product_id" = p."id" ORDER BY o."id"
----
1 Rustic Paper Wallet
2 Rustic Paper Wallet
3 Synergistic Granite Chair
4 Practical Bronze Computer
5 Aerodynamic Bronze Hat
6 Small Marble Shoes
7 Durable Rubber Chair
8 Ergonomic Silk Coat
9 Practical Bronze Computer

query IT
SELECT o."id", p."title" FROM "orders" o LEFT JOIN "products" p ON o."product_id" = p."id" WHERE p."id" IS NULL ORDER BY o."id"
----
10 NULL

query TR
SELECT p."category", sum(o."total") AS "revenue" FROM "orders" o JOIN "products" p ON o."product_id" = p."id" GROUP BY p."category" ORDER BY p."category" NULLS LAST
----
Doohickey 351.80
Gizmo 150.30
Widget 331.33
NULL 161.00

query IT
SELECT p."id", p."title" FROM "products" p WHERE NOT EXISTS (SELECT 1 FROM "orders" o WHERE o."product_id" = p."id") ORDER BY p."id"
----
4 Enormous Aluminum Shirt

query I
SELECT "id" FROM "products" WHERE "id" IN (SELECT "product_id" FROM "orders" WHERE "quantity" > 2) ORDER BY "id"
----
2
3
6

query II
SELECT s."product_id", s."qty" FROM (SELECT "product_id", sum("quantity") AS "qty" FROM "orders" GROUP BY "product_id") s WHERE s."qty" >= 3 ORDER BY s."product_id"
----
1 3
2 3
3 4
5 3
6 10

query TI
SELECT p."title", (SELECT count(*) FROM "orders" o WHERE o."product_id" = p."id") AS "n" FROM "products" p ORDER BY p."id" LIMIT 4
----
Rustic Paper Wallet 2
Small Marble Shoes 1
Synergistic Granite Chair 1
Enormous Aluminum Shirt 0
